<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <!-- ============================ 1. 拨号盘 ============================ -->
    <LinearLayout
        android:id="@+id/screenDialer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="#F1F5F9"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="@string/status_unregistered"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/settingsBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_secondary"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"
                android:text="@string/btn_settings"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/accountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dialedText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#F8FAFC"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- 3x4 键盘 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key1"
                style="@style/NsbcKey" />

            <Button
                android:id="@+id/key2"
                style="@style/NsbcKey"
                android:layout_marginStart="12dp" />

            <Button
                android:id="@+id/key3"
                style="@style/NsbcKey"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key4"
                style="@style/NsbcKey" />

            <Button
                android:id="@+id/key5"
                style="@style/NsbcKey"
                android:layout_marginStart="12dp" />

            <Button
                android:id="@+id/key6"
                style="@style/NsbcKey"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key7"
                style="@style/NsbcKey" />

            <Button
                android:id="@+id/key8"
                style="@style/NsbcKey"
                android:layout_marginStart="12dp" />

            <Button
                android:id="@+id/key9"
                style="@style/NsbcKey"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/keyStar"
                style="@style/NsbcKey"
                android:text="*" />

            <Button
                android:id="@+id/key0"
                style="@style/NsbcKey"
                android:layout_marginStart="12dp" />

            <Button
                android:id="@+id/keyHash"
                style="@style/NsbcKey"
                android:layout_marginStart="12dp"
                android:text="#" />
        </LinearLayout>

        <!-- 拨出 / 退格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backspaceBtn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_keypad"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="@string/btn_backspace"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="20sp" />

            <Button
                android:id="@+id/callBtn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_call"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text="@string/btn_call"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/recent_title"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/recentEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/recent_empty"
                android:textColor="#475569"
                android:textSize="12sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/recentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- ============================ 2. 设置 ============================ -->
    <ScrollView
        android:id="@+id/screenSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B1220"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settingsBackBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_secondary"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_back"
                    android:textAllCaps="false"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/btn_settings"
                    android:textColor="#F1F5F9"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 账号 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_account"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/serverInput"
                    style="@style/NsbcField"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_server"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/portInput"
                    style="@style/NsbcField"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_port"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/realmInput"
                    style="@style/NsbcField"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_realm"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/userInput"
                    style="@style/NsbcField"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_user"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/passInput"
                    style="@style/NsbcField"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_pass"
                    android:inputType="textPassword" />

                <EditText
                    android:id="@+id/displayInput"
                    style="@style/NsbcField"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_display"
                    android:inputType="textPersonName" />
            </LinearLayout>

            <!-- 网络 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_network"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/tlsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_tls"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/pathInput"
                    style="@style/NsbcField"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_ws_path"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/stunInput"
                    style="@style/NsbcField"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_stun"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/turnInput"
                    style="@style/NsbcField"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_turn"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/turnUserInput"
                    style="@style/NsbcField"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_turn_user"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/turnCredInput"
                    style="@style/NsbcField"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_turn_cred"
                    android:inputType="textPassword" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_ice"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/iceSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 媒体 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_media"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/videoSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_video"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/widthInput"
                        style="@style/NsbcField"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_video_width"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/heightInput"
                        style="@style/NsbcField"
                        android:layout_width="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_video_height"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/fpsInput"
                        style="@style/NsbcField"
                        android:layout_width="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_video_fps"
                        android:inputType="number" />
                </LinearLayout>

                <Switch
                    android:id="@+id/mirrorSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_mirror"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 高级 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_advanced"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/reconnectSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_auto_reconnect"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/selfSignedSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_self_signed"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_log_level"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/logSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/problemsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/saveConnectBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_call"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text="@string/btn_save_connect"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/disconnectBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secondary"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text="@string/btn_disconnect"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="14sp" />

            <Button
                android:id="@+id/resetBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:text="@string/btn_reset"
                android:textAllCaps="false"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ============================ 3. 通话中 ============================ -->
    <FrameLayout
        android:id="@+id/screenCall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/callAvatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_keypad"
            android:gravity="center"
            android:textColor="#E2E8F0"
            android:textSize="30sp"
            android:textStyle="bold" />

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/remoteView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/callName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/callSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/callTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="00:00"
                android:textColor="#93C5FD"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 本地预览（可拖动） -->
        <FrameLayout
            android:id="@+id/localContainer"
            android:layout_width="104dp"
            android:layout_height="148dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="92dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_pip"
            android:elevation="6dp">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/localView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="28dp">

            <Button
                android:id="@+id/muteBtn"
                style="@style/NsbcCallAction"
                android:text="@string/btn_mute" />

            <Button
                android:id="@+id/speakerBtn"
                style="@style/NsbcCallAction"
                android:layout_marginStart="8dp"
                android:text="@string/btn_speaker" />

            <Button
                android:id="@+id/videoBtn"
                style="@style/NsbcCallAction"
                android:layout_marginStart="8dp"
                android:text="@string/btn_video_off" />

            <Button
                android:id="@+id/switchBtn"
                style="@style/NsbcCallAction"
                android:layout_marginStart="8dp"
                android:text="@string/btn_switch" />

            <Button
                android:id="@+id/hangupBtn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_hangup"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="@string/btn_hangup"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ============================ 4. 来电 ============================ -->
    <FrameLayout
        android:id="@+id/incomingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B1220"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/incoming_label"
                android:textColor="#93C5FD"
                android:textSize="13sp"
                android:letterSpacing="0.2" />

            <TextView
                android:id="@+id/incomingAvatar"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_keypad"
                android:gravity="center"
                android:textColor="#E2E8F0"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incomingName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incomingUri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/rejectBtn"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hangup"
                    android:includeFontPadding="false"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_reject"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/answerBtn"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_call"
                    android:includeFontPadding="false"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_answer"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
