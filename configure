#!/bin/sh
# =====================================================================
# NSBC configure — FreeSWITCH-style compile-time module trimming + shared library separation
# =====================================================================
# layering strategy (REQ-ARCH-010):
#   STATIC group —— REQUIRED / CALL_PATH / MOD_L_EARLY modules -> static link into nsbcd main binary
#                EARLY also goes STATIC: dlopen depends on mem/rcu which isn't initialized yet at EARLY stage
#   DYNAMIC group —— non REQUIRED/CALL_PATH/EARLY -> build/mod/mod_*.so,
#                    dlopen at startup (only modules selected in modules.conf are loaded)
#
# Usage:
#   ./configure                                # default: modules.conf + all enabled (except disabled)
#   ./configure --with-modules=a,b,c          # whitelist: only build these (REQUIRED forced into STATIC)
#   ./configure --without-modules=x,y,z       # blacklist: don't build these
#   ./configure --modules-conf=<path>         # specify a different modules.conf
#   ./configure --prefix=/usr/local           # install prefix
#
# Generated artifacts (separates "config" and "build" directories, make clean only deletes build/ not .config/):
#   .config/config.mk                      Makefile includes it (project root, survives clean)
#   src/core/builtin_modules.gen.inc       builtin.c __has_include priority include
#   build/mod/mod.load                     dynamic module .so path list (same dir as .so, dlopen uses it)
#   build/mod/mod_*.so                     shared libraries (Makefile builds)
# =====================================================================

set -e

CONFIG_DIR="."

usage() {
    sed -n '2,30p' "$0"
    exit 0
}

WITH_MODS=""
WITHOUT_MODS=""
MODS_CONF="conf/modules.conf"
PREFIX="/usr/local"

while [ $# -gt 0 ]; do
    case "$1" in
        --with-modules=*)   WITH_MODS=$(echo "$1" | sed 's/^--with-modules=//') ;;
        --without-modules=*) WITHOUT_MODS=$(echo "$1" | sed 's/^--without-modules=//') ;;
        --modules-conf=*)   MODS_CONF=$(echo "$1" | sed 's/^--modules-conf=//') ;;
        --prefix=*)         PREFIX=$(echo "$1" | sed 's/^--prefix=//') ;;
        -h|--help)          usage ;;
        *)                  echo "Unknown arg: $1" >&2; usage ;;
    esac
    shift
done

TMP=$(mktemp -d /tmp/nsbc_conf_XXXXXX)
trap 'rm -rf "$TMP"' EXIT

MODS_DB="$TMP/mods.db"          # module metadata: name|dir|src_file|req|cp|lvl|deps_list

# =====================================================================
# 1. scan all module definitions (full src/**/*.c, exclude 3rd / tests)
#    each line format: NAME|DIR|SRC_FILE|REQ|CP|LEVEL_NUM|DEPS_CSV
#
#    scan strategy (fixes 7 bugs from v1):
#      - extract module name from first macro argument, no longer using directory basename (callcenter has agent_pool + queue)
#      - each .c file can contain multiple NSBC_MOD/NSBC_MOD0 macros (loop to capture all)
#      - deps extraction uses awk cross-line concatenation, supports multi-line macros (signaling uses \ continuation)
#      - NSBC_MOD and NSBC_MOD0 uniformly do dep parsing (media_bug uses NSBC_MOD0 but has deps)
#      - supports inline deps arrays (const char *[]){ "xxx", NULL } (hello module style)
#      - scan scope src/**/*.c, covers non-src/mod paths like src/media/bridge/hep_sink.c
# =====================================================================

# ---------------------------------------------------------------------
# scan_file: parse all NSBC_MOD / NSBC_MOD0 macros in a single .c file
# params: $1 = .c file path (relative to project root)
# output (one module per line): NAME|DIR|SRC_FILE|REQ|CP|LEVEL_NUM|DEPS_CSV
# ---------------------------------------------------------------------
scan_file() {
    local src_file="$1"
    local mod_dir
    mod_dir=$(dirname "$src_file")

    # -----------------------------------------------------------------
    # single awk pass does two things:
    #   1) scan whole file, store all xxx[] = { "yyy", NULL } named arrays into deps_map[var] = "yyy,zzz"
    #   2) cross-line concatenate NSBC_MOD / NSBC_MOD0 macros, parse module metadata, deps_var looks up in deps_map
    # output: one module per line  NAME|DIR|SRC_FILE|REQ|CP|LEVEL_NUM|DEPS_CSV
    # -----------------------------------------------------------------
    awk -v src="$src_file" -v dir="$mod_dir" '
    # ===== phase 1: scan named deps array definitions =====
    /\[\][[:space:]]*=/ && match($0, /[a-zA-Z_][a-zA-Z0-9_]*\[\][[:space:]]*=/) {
        line = $0
        # extract variable name (strip const char * etc. prefixes)
        sub(/^[[:space:]]*/, "", line)
        sub(/\[\].*/, "", line)
        sub(/^(const[[:space:]]+)?char[[:space:]]*\*[[:space:]]*/, "", line)
        cur_dvar = line
        in_darr = 1
        darr_buf = ""
        # find content after { on same line
        idx = index($0, "{")
        if (idx > 0) darr_buf = substr($0, idx + 1)
        next
    }
    in_darr && cur_dvar != "" {
        darr_buf = darr_buf " " $0
        if (match($0, /\}/)) {
            in_darr = 0
            # extract all "xxx" from darr_buf
            csv = ""
            while (match(darr_buf, /"[^"]*"/)) {
                s = substr(darr_buf, RSTART + 1, RLENGTH - 2)
                if (s != "NULL" && s != "") {
                    if (csv == "") csv = s; else csv = csv "," s
                }
                darr_buf = substr(darr_buf, RSTART + RLENGTH)
            }
            if (csv != "") deps_map[cur_dvar] = csv
            cur_dvar = ""; darr_buf = ""
        }
        next
    }

    # ===== phase 2: scan NSBC_MOD / NSBC_MOD0 macros =====
    {
        line = $0
        sub(/\\$/, "", line)          # strip trailing \ continuation

        if (!in_macro) {
            if (match(line, /NSBC_MOD0?(_CAT)?\(/)) {
                buf = line
                in_macro = 1
                depth = 1
                rest = substr(line, RSTART + RLENGTH)
                for (i = 1; i <= length(rest); i++) {
                    c = substr(rest, i, 1)
                    if (c == "(") depth++
                    else if (c == ")") depth--
                    if (depth == 0) break
                }
                if (depth == 0) {
                    process_macro(buf, src, dir)
                    buf = ""; in_macro = 0; depth = 0
                }
            }
        } else {
            buf = buf " " line
            for (i = 1; i <= length(line); i++) {
                c = substr(line, i, 1)
                if (c == "(") depth++
                else if (c == ")") depth--
                if (depth == 0) break
            }
            if (depth == 0) {
                process_macro(buf, src, dir)
                buf = ""; in_macro = 0; depth = 0
            }
        }
    }

    function process_macro(full, src,   dir,    # args
                           name, level_num, has_req, has_cp, deps_csv,
                           n, parts, lv, deps_arg, arr_text, inner,
                           is_cat, deps_idx) {
        # check if NSBC_MOD_CAT / NSBC_MOD0_CAT — check before stripping macro header
        is_cat = 0
        if (index(full, "NSBC_MOD_CAT(") > 0 || index(full, "NSBC_MOD0_CAT(") > 0) {
            is_cat = 1
        }

        # strip ); suffix + macro header
        sub(/\);?[[:space:]]*$/, "", full)
        sub(/^NSBC_MOD0?(_CAT)?\(/, "", full)

        n = split_top_commas(full, parts)
        if (n < 4) return

        name = strip(parts[1])
        gsub(/"/, "", name)

        # level
        lv = strip(parts[3])
        level_num = 9
        if (lv == "MOD_L_EARLY")        level_num = 0
        else if (lv == "MOD_L_MEM_READY")    level_num = 1
        else if (lv == "MOD_L_NET_READY")    level_num = 2
        else if (lv == "MOD_L_WORKER_READY") level_num = 3
        else if (lv == "MOD_L_FINAL")        level_num = 4

        # flags
        has_req = index(full, "MOD_F_REQUIRED") > 0 ? 1 : 0
        has_cp  = index(full, "MOD_F_CALL_PATH") > 0 ? 1 : 0

        # deps —— NSBC_MOD(0) is parts[5], NSBC_MOD(0)_CAT has extra cat param in parts[5], deps shifts to parts[6]
        deps_csv = ""
        deps_idx = is_cat ? 6 : 5
        if (n >= deps_idx) {
            deps_arg = strip(parts[deps_idx])
            if (index(deps_arg, "{") > 0) {
                # inline array: strip (const char *[]) prefix before {
                arr_text = deps_arg
                sub(/^[^}]*\{/, "{", arr_text)
                while (match(arr_text, /"[^"]*"/)) {
                    inner = substr(arr_text, RSTART + 1, RLENGTH - 2)
                    if (inner != "NULL" && inner != "") {
                        if (deps_csv == "") deps_csv = inner; else deps_csv = deps_csv "," inner
                    }
                    arr_text = substr(arr_text, RSTART + RLENGTH)
                }
            } else if (deps_arg != "NULL" && deps_arg != "" && deps_arg in deps_map) {
                # named array — scanned in phase 1
                deps_csv = deps_map[deps_arg]
            }
        }

        printf "%s|%s|%s|%d|%d|%d|%s\n", name, dir, src, has_req, has_cp, level_num, deps_csv
    }

    function split_top_commas(s, out,    i, c, depth_p, depth_b, in_str, cur, n) {
        delete out
        depth_p = 0; depth_b = 0; in_str = 0; cur = ""; n = 0
        for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (c == "\"" && (i == 1 || substr(s, i-1, 1) != "\\")) in_str = !in_str
            if (!in_str) {
                if (c == "(") depth_p++
                else if (c == ")") depth_p--
                else if (c == "{") depth_b++
                else if (c == "}") depth_b--
                else if (c == "," && depth_p == 0 && depth_b == 0) {
                    n++; out[n] = cur; cur = ""
                    continue
                }
            }
            cur = cur c
        }
        n++; out[n] = cur
        return n
    }

    function strip(s) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
        return s
    }
    ' "$src_file"
}

# =====================================================================
# full scan src/**/*.c (exclude 3rd / tests / generated files)
# =====================================================================

# scan all source files — while read must be in current shell (not pipeline subshell) to call scan_file
find src -name '*.c' -type f \
    ! -path 'src/core/stub_mods.c' \
    | sort > "$TMP/srcfiles.txt"

: > "$MODS_DB"
while IFS= read -r f; do
    scan_file "$f" >> "$MODS_DB"
done < "$TMP/srcfiles.txt"

# ---------------------------------------------------------------------
# dedup (by module name, keep first scanned)
# ---------------------------------------------------------------------
if [ -s "$MODS_DB" ]; then
    awk -F'|' '!seen[$1]++' "$MODS_DB" > "$TMP/mods_dedup.db"
    mv "$TMP/mods_dedup.db" "$MODS_DB"
fi

# ========== hard-inject critical modules (guard against scan_file regex misses) ==========
# format: NAME|DIR|SRC_FILE|REQ|CP|LEVEL_NUM|DEPS_CSV
# req=1 REQUIRED, cp=1 CALL_PATH, level 0=EARLY 2=NET_READY 3=WORKER_READY 4=FINAL
HARD_INJECT_LINES="oam|src/oam|src/oam/oam_module.c|1|0|4|signaling
security|src/mod/security|src/mod/security/security.c|1|0|4|oam,signaling
billing|src/mod/billing|src/mod/billing/billing.c|1|0|4|
applications|src/mod/applications|src/mod/applications/applications.c|1|0|4|
ha|src/ha|src/ha/ha.c|1|0|4|signaling"
echo "$HARD_INJECT_LINES" | while IFS='|' read -r hname rest; do
    if ! grep -q "^${hname}|" "$MODS_DB"; then
        echo "${hname}|${rest}" >> "$MODS_DB"
        echo "  ↑ injected: $hname (scan missed, hardcoded)" >&2
    fi
done
# ================================================================

if [ ! -s "$MODS_DB" ]; then
    echo "ERROR: no module definitions found (NSBC_MOD/NSBC_MOD0)" >&2
    exit 1
fi

# =====================================================================
# 2. read modules.conf (whitelist / blacklist)
# =====================================================================

ENABLE_LIST=""
DISABLE_LIST=""
REQUIRED_LIST=$(awk -F'|' '$4==1 {print $1}' "$MODS_DB")

if [ -f "$MODS_CONF" ]; then
    in_autoload=0
    while IFS= read -r raw; do
        # strip inline comments starting with ; and trailing whitespace
        line=$(echo "$raw" | sed 's/;.*$//' | sed 's/[[:space:]]*$//')
        [ -z "$line" ] && continue
        case "$line" in \#*) continue ;; esac
        case "$line" in
            '[autoload]') in_autoload=1; continue ;;
            '['*)         in_autoload=0; continue ;;
        esac
        [ "$in_autoload" -eq 0 ] && continue

        kw=$(echo "$line" | awk '{print $1}')
        arg=$(echo "$line" | awk '{print $2}')
        case "$kw" in
            enable)  ENABLE_LIST="$ENABLE_LIST $arg" ;;
            disable) DISABLE_LIST="$DISABLE_LIST $arg" ;;
        esac
    done < "$MODS_CONF"
else
    echo "WARN: $MODS_CONF not found -> command-line override or default (all enabled)"
fi

# command-line overrides
if [ -n "$WITH_MODS" ]; then
    ENABLE_LIST=$(echo "$WITH_MODS" | tr ',' ' ')
fi
if [ -n "$WITHOUT_MODS" ]; then
    for m in $(echo "$WITHOUT_MODS" | tr ',' ' '); do
        DISABLE_LIST="$DISABLE_LIST $m"
    done
fi

# =====================================================================
# 3. compute FINAL_ENABLED + split STATIC/DYNAMIC
# =====================================================================

FINAL_ENABLED=""
has_whitelist=0
[ -n "$ENABLE_LIST" ] && has_whitelist=1

# set membership test
in_list() {
    case " $2 " in *" $1 "*) return 0 ;; esac
    return 1
}

ALL_SCANNED=$(awk -F'|' '{print $1}' "$MODS_DB")

if [ "$has_whitelist" -eq 1 ]; then
    # whitelist mode: REQUIRED forced in; enable items in; but disable items must not conflict with enable
    for name in $REQUIRED_LIST; do
        FINAL_ENABLED="$FINAL_ENABLED $name"
    done
    for name in $ENABLE_LIST; do
        in_list "$name" "$DISABLE_LIST" && {
            echo "ERROR: '$name' appears in both enable and disable — conflict" >&2; exit 1;
        }
        grep -q "^${name}|" "$MODS_DB" || {
            echo "WARN: enable '$name' not found in src/**/*.c — ignoring (possibly typo)" >&2
            continue
        }
        in_list "$name" "$FINAL_ENABLED" || FINAL_ENABLED="$FINAL_ENABLED $name"
    done
else
    # blacklist mode: all scanned modules enabled, except those in disable
    for name in $ALL_SCANNED; do
        in_list "$name" "$DISABLE_LIST" && {
            in_list "$name" "$REQUIRED_LIST" && {
                echo "ERROR: REQUIRED module '$name' cannot be disabled" >&2; exit 1;
            }
            continue
        }
        FINAL_ENABLED="$FINAL_ENABLED $name"
    done
fi

# split STATIC (REQUIRED or CALL_PATH or EARLY) / DYNAMIC (other FINAL_ENABLED)
# EARLY forced into STATIC: dlopen depends on mem/rcu infrastructure not yet initialized at EARLY stage
STATIC_MODS=""
DYNAMIC_MODS=""
while IFS='|' read -r name dir src_file req cp lvl deps_csv; do
    in_list "$name" "$FINAL_ENABLED" || continue
    if [ "$req" -eq 1 ] || [ "$cp" -eq 1 ] || [ "$lvl" -eq 0 ]; then
        STATIC_MODS="$STATIC_MODS $name"
    else
        DYNAMIC_MODS="$DYNAMIC_MODS $name"
    fi
done < "$MODS_DB"

# ---- hardcoded forced promotion: modules that the main binary hard-depends on ----
# src/core/signaling.c / stub_mods.c / src/oam/obs_control.c / src/sip/b2bua.c
# directly call dp_*/rt_*/recording_*/bill_*/outreg_*/app_* etc. functions.
# if these modules end up in DYNAMIC group -> STATIC link misses symbols -> undefined reference.
# architecture is like this — without hardcoding these, linking fails.
# ha: b2bua.c directly calls ha_role() for primary/standby signaling gating, and src/ha/*.c is already
# compiled into main binary via SRCS_CORE — if it falls to DYNAMIC, .so/main binary would have duplicate state,
# gating reads NULL g_ha from main binary, always ACTIVE, effectively useless.
# security: b2bua.c has three access points (besides INVITE/REGISTER guard and OPTIONS) directly calling
# security_blacklist_check() for silent interception — must be STATIC to link into main binary.
HARD_STATIC="oam dialplan outreg recording billing applications media_bug ha security playback"
for m in $HARD_STATIC; do
    if in_list "$m" "$DYNAMIC_MODS"; then
        STATIC_MODS="$STATIC_MODS $m"
        DYNAMIC_MODS=$(echo " $DYNAMIC_MODS " | sed "s/ $m / /g" | sed 's/^ *//;s/ *$//')
        echo "  ↑ forced STATIC (hard dep): $m" >&2
    fi
done

# =====================================================================
# 4. dependency validation
#    rules:
#      - deps of enabled modules must also be enabled (cannot be disabled)
#      - deps of STATIC modules cannot be DYNAMIC (STATIC inits first, DYNAMIC not yet dlopen'd -> NULL ptr)
#      - deps of DYNAMIC modules can be STATIC or DYNAMIC (STATIC inits first, DYNAMIC dlopen'd later)
# =====================================================================

is_static() { case " $STATIC_MODS " in *" $1 "*) return 0 ;; esac; return 1; }
is_dynamic() { case " $DYNAMIC_MODS " in *" $1 "*) return 0 ;; esac; return 1; }

while IFS='|' read -r name dir src_file req cp lvl deps_csv; do
    in_list "$name" "$FINAL_ENABLED" || continue
    [ -z "$deps_csv" ] && continue
    owner_static=0; is_static "$name" && owner_static=1
    for dep in $(echo "$deps_csv" | tr ',' ' '); do
        [ -z "$dep" ] && continue
        in_list "$dep" "$FINAL_ENABLED" || {
            echo "ERROR: '$name' depends on '$dep' but '$dep' is not enabled" >&2
            exit 1
        }
        if [ "$owner_static" -eq 1 ] && is_dynamic "$dep"; then
            echo "ERROR: STATIC module '$name' depends on DYNAMIC module '$dep' — STATIC inits first, DYNAMIC not yet dlopen'd" >&2
            echo "       fix: make '$dep' also REQUIRED/CALL_PATH/EARLY so it goes STATIC" >&2
            exit 1
        fi
    done
done < "$MODS_DB"

# =====================================================================
# 4.5 external dependency pkg-config detection
# =====================================================================

# ---- SQLite (Phase E-04: cdr_wal sqlite3 WAL backend) ----
# stronger than text WAL: PRAGMA journal_mode=WAL + persisted committed field + SELECT replay
# auto-falls back to text WAL when sqlite3 not found (CRC+batch+replay truncate)
HAVE_SQLITE3=0
SQLITE_CPPFLAGS=""
SQLITE_LDLIBS=""
if command -v pkg-config >/dev/null 2>&1 \
   && pkg-config --exists sqlite3 2>/dev/null; then
    HAVE_SQLITE3=1
    SQLITE_CPPFLAGS=$(pkg-config --cflags sqlite3 2>/dev/null)
    SQLITE_LDLIBS=$(pkg-config --libs   sqlite3 2>/dev/null)
    echo "  ↑ sqlite3 detected — cdr_wal sqlite3 backend enabled" >&2
else
    echo "  ↑ sqlite3 NOT found — cdr_wal falls back to text WAL (CRC+batch)" >&2
    echo "    install: apt-get install libsqlite3-dev" >&2
fi

# ---- FFmpeg (mod_av commercial codec unified backend) ----
HAVE_FFMPEG=0
AV_CPPFLAGS=""
AV_LDLIBS=""
if command -v pkg-config >/dev/null 2>&1 \
   && pkg-config --exists libavcodec libavutil libswresample libswscale 2>/dev/null; then
    HAVE_FFMPEG=1
    AV_CPPFLAGS=$(pkg-config --cflags libavcodec libavutil libswresample libswscale 2>/dev/null)
    AV_LDLIBS=$(pkg-config --libs   libavcodec libavutil libswresample libswscale 2>/dev/null)
    echo "  ↑ FFmpeg detected (avcodec+avutil+swresample+swscale)" >&2
else
    echo "  ↑ FFmpeg NOT found — mod_av stub mode (compile with -DHAVE_FFMPEG after apt install libavcodec-dev)" >&2
fi

# =====================================================================
# 5. generate build artifacts
# =====================================================================

mkdir -p build build/mod src/core

# ---- .config/config.mk ----
{
    echo "# Auto-generated by configure — DO NOT EDIT"
    echo "# Generated: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "# Prefix    : $PREFIX"
    echo "# Modules conf: $MODS_CONF"
    echo ""
    echo "# ---- Static modules (REQUIRED or CALL_PATH or EARLY) — linked into nsbcd ----"
    printf "STATIC_MODS ="
    for m in $(echo "$STATIC_MODS" | tr ' ' '\n' | sort); do printf ' %s' "$m"; done
    echo ""
    echo "# ---- Dynamic modules (non REQUIRED/CALL_PATH/EARLY) — built as .so ----"
    printf "DYNAMIC_MODS ="
    for m in $(echo "$DYNAMIC_MODS" | tr ' ' '\n' | sort); do printf ' %s' "$m"; done
    echo ""
    echo ""

    # STATIC_MOD_SRCS: find for each STATIC module
    # dir preferentially from MODS_DB scan; fall back to hardcoded when not found (critical modules safety net)
    echo "STATIC_MOD_SRCS = \\"
    first=1
    for name in $(echo "$STATIC_MODS" | tr ' ' '\n' | sort); do
        dir=$(awk -F'|' -v n="$name" '$1==n {print $2; exit}' "$MODS_DB")
        if [ -z "$dir" ]; then
            # hardcoded fallback: critical modules can still build even if scan missed
            case "$name" in
                oam)         dir="src/oam" ;;
                ha)          dir="src/ha" ;;
                security)    dir="src/mod/security" ;;
                applications) dir="src/mod/applications" ;;
                billing)     dir="src/mod/billing" ;;
                dialplan)    dir="src/mod/dialplans" ;;
                outreg)      dir="src/mod/outbound_reg" ;;
                recording)   dir="src/mod/recording" ;;
                endpoints)   dir="src/mod/endpoints" ;;
                agent_pool)  dir="src/mod/callcenter" ;;
                queue)       dir="src/mod/callcenter" ;;
                hep)         dir="src/media/bridge" ;;
                signaling)   dir="src/sip" ;;
                dbal)        dir="src/db" ;;
                *)           dir="src/mod/$name" ;;
            esac
            echo "  # WARNING: $name dir='$dir' (MODS_DB miss, hardcoded fallback)" >&2
        fi
        s="  \$(shell find $dir -name '*.c')"
        if [ "$first" -eq 1 ]; then
            echo "$s \\"
            first=0
        else
            echo "$s \\"
        fi
    done
    # recording module additionally includes src/media/rec (implementation spread there)
    if grep -q "^recording|" "$MODS_DB"; then
        if in_list "recording" "$STATIC_MODS"; then
            echo "  \$(shell find src/media/rec -name '*.c') \\"
        fi
    fi
    # playback module additionally includes src/media/play (WAV player core: player.c)
    if grep -q "^playback|" "$MODS_DB"; then
        if in_list "playback" "$STATIC_MODS"; then
            echo "  \$(shell find src/media/play -name '*.c') \\"
        fi
    fi

    # DYNAMIC_MOD_SRCS: only for mod_%.so rule
    echo ""
    echo "# ---- Dynamic modules per-module src (for mod_%.so rule) ----"
    while IFS='|' read -r name dir src_file req cp lvl deps_csv; do
        in_list "$name" "$DYNAMIC_MODS" || continue
        echo "MOD_SRC_${name} = \$(shell find $dir -name '*.c')"
    done < "$MODS_DB"
    # recording special case: src/mod/recording + src/media/rec must both be built in
    in_list "recording" "$DYNAMIC_MODS" && echo "MOD_SRC_recording = \$(shell find src/mod/recording src/media/rec -name '*.c')"
    # ai_dialog special case: also depends on src/mod/codecs/g711_codec.c (mock encode/decode)
    in_list "ai_dialog" "$DYNAMIC_MODS" && echo "MOD_SRC_ai_dialog = \$(shell find src/mod/ai_dialog -name '*.c'; find src/mod/codecs -name 'g711_codec.c')"
    # codecs special case: real codec impl + vendored bcg729
    in_list "codecs" "$DYNAMIC_MODS" && echo "MOD_SRC_codecs = \$(shell find src/mod/codecs -name '*.c'; find 3rd/bcg729/src -name '*.c')"
    # playback special case: depends on src/media/play/player.c (WAV player core)
    in_list "playback" "$DYNAMIC_MODS" && echo "MOD_SRC_playback = \$(shell find src/mod/playback -name '*.c'; find src/media/play -name '*.c')"

    echo ""
    echo "# ---- SQLite WAL detection (Phase E-04) ----"
    if [ "$HAVE_SQLITE3" -eq 1 ]; then
        echo "CPPFLAGS += -DNSBC_WITH_SQLITE $SQLITE_CPPFLAGS"
        echo "SQLITE_LDLIBS = $SQLITE_LDLIBS"
    else
        echo "# sqlite3 not found — cdr_wal text WAL (CRC+batch) is the only backend"
        echo "# install: apt-get install libsqlite3-dev then re-run configure"
        echo "SQLITE_LDLIBS = "
    fi

    echo ""
    echo "# ---- FFmpeg detection (mod_av heavy dep) ----"
    if [ "$HAVE_FFMPEG" -eq 1 ]; then
        echo "CPPFLAGS += -DHAVE_FFMPEG $AV_CPPFLAGS"
        echo "AV_LDLIBS = $AV_LDLIBS"
    else
        echo "# FFmpeg not found — mod_av stub mode (ops->init=NULL -> transcode_open returns NOTSUP)"
        echo "# install: apt-get install libavcodec-dev libavutil-dev libswresample-dev libswscale-dev"
        echo "# then re-run configure"
        echo "AV_LDLIBS = "
    fi

    echo ""
    echo "# ---- CPPFLAGS: WITH_DLOPEN + HAVE_MOD_xxx macros ----"
    echo "CPPFLAGS += -DNSBC_WITH_DLOPEN=1"
    mod_flags=""
    for name in $(echo "$FINAL_ENABLED" | tr ' ' '\n' | sort); do
        mod_flags="$mod_flags -DHAVE_MOD_$(echo "$name" | tr '[:lower:]' '[:upper:]')"
    done
    [ -n "$mod_flags" ] && echo "CPPFLAGS +=$mod_flags"

    echo ""
    echo "# ---- Post-build: copy build/mod to project root (nsbcd same directory) ----"
    echo "# nsbcd startup: exe_dir/mod/mod.load -> dlopen exe_dir/mod/mod_xxx.so"
    echo "# install-time PREFIX/sbin/nsbcd -> PREFIX/lib/nsbc/ handled separately (does not depend on this)"
    if [ -n "$DYNAMIC_MODS" ]; then
        echo "POST_BUILD_COPY = rm -rf ./mod && cp -a build/mod ./mod"
    else
        echo "POST_BUILD_COPY ="
    fi

} > "$CONFIG_DIR/config.mk"
echo "  ✓ $CONFIG_DIR/config.mk ($(wc -l < "$CONFIG_DIR/config.mk") lines)" >&2

# ---- src/core/builtin_modules.gen.inc ----
# STATIC group ordered by level_num ascending + name alphabetical
# note: `awk "$MODS_DB"` when MODS_DB is missing (exit 2 under set -e) would cause script to silently stall here —
# config.mk already written but builtin file not generated. Add || { echo error; exit 1; } for explicit error.
if [ ! -s "$MODS_DB" ]; then
    echo "ERROR: MODS_DB=$MODS_DB missing or empty before builtin generation" >&2
    exit 1
fi
STATIC_ORDERED=$(awk -F'|' -v enabled="$STATIC_MODS" '
    BEGIN {
        n = split(enabled, en, " ")
        for (i=1; i<=n; i++) en_set[en[i]] = 1
    }
    ($1 in en_set) { printf "%d|%s\n", $6, $1 }
' "$MODS_DB" | sort -t'|' -k1,1n -k2,2 | awk -F'|' '{print $2}')

{
    echo "/* Auto-generated by configure — DO NOT EDIT */"
    echo "/* Generated: $(date '+%Y-%m-%d %H:%M:%S') */"
    echo "/* This file is #include'd by src/core/builtin.c via __has_include. */"
    echo "/* Only STATIC group (REQUIRED or CALL_PATH or EARLY) goes here. Dynamic modules */"
    echo "/* are built as .so and loaded at startup via modmgr_load_all(). */"
    echo ""
    for name in $STATIC_ORDERED; do
        echo "extern const nsbc_module_t nsbcm_${name};"
    done
    echo ""
    echo "const nsbc_module_t *const nsbc_builtin_modules[] = {"
    for name in $STATIC_ORDERED; do
        echo "    &nsbcm_${name},"
    done
    echo "    (const nsbc_module_t *)0"
    echo "};"
} > src/core/builtin_modules.gen.inc
echo "  ✓ src/core/builtin_modules.gen.inc ($(wc -l < src/core/builtin_modules.gen.inc) lines, STATIC=$(echo "$STATIC_ORDERED" | tr '\n' ' '))" >&2

# ---- build/mod/mod.load ---- dynamic module .so path list (one per line)
# key: mod.load must be in same directory as .so; modmgr_load_all uses dirname(list_path) as dlopen base dir
# so nsbcd reads from exe_dir/mod/mod.load -> dlopen exe_dir/mod/mod_xxx.so — works regardless of cwd
mkdir -p build/mod
if [ -n "$DYNAMIC_MODS" ]; then
    : > build/mod/mod.load
    for name in $(echo "$DYNAMIC_MODS" | tr ' ' '\n' | sort); do
        # only store bare filename — works the same after install at /etc/nsbc/mod/mod.load
        echo "mod_${name}.so" >> build/mod/mod.load
    done
else
    rm -f build/mod/mod.load
fi

# =====================================================================
# 6. print summary
# =====================================================================

n_static=$(echo "$STATIC_MODS" | tr ' ' '\n' | sed '/^$/d' | wc -l)
n_dynamic=$(echo "$DYNAMIC_MODS" | tr ' ' '\n' | sed '/^$/d' | wc -l)
n_disabled=$(echo "$DISABLE_LIST" | tr ' ' '\n' | sed '/^$/d' | wc -l)
[ -z "$DISABLE_LIST" ] && n_disabled=0

echo ""
echo "========================================"
echo "  NSBC configure done"
echo "========================================"
echo "Modules conf   : $MODS_CONF"
echo "Prefix         : $PREFIX"
echo ""
printf "Static  (REQUIRED/CALL_PATH/EARLY) : %d\n" "$n_static"
for name in $(echo "$STATIC_MODS" | tr ' ' '\n' | sort); do
    tag=""
    case " $REQUIRED_LIST " in *" $name "*) tag="${tag} (REQUIRED)" ;; esac
    lvl=$(awk -F'|' -v n="$name" '$1==n {print $6; exit}' "$MODS_DB")
    [ "$lvl" = "0" ] && tag="${tag} (EARLY)"
    echo "  [S] $name$tag"
done
printf "Dynamic (.so dlopen)         : %d\n" "$n_dynamic"
for name in $(echo "$DYNAMIC_MODS" | tr ' ' '\n' | sort); do
    echo "  [D] $name → build/mod/mod_${name}.so"
done
if [ "$n_disabled" -gt 0 ]; then
    printf "Disabled                     : %d\n" "$n_disabled"
    for name in $(echo "$DISABLE_LIST" | tr ' ' '\n' | sort); do
        echo "  [X] $name"
    done
fi
echo ""
echo "Output:"
echo "  $CONFIG_DIR/config.mk            (Makefile include, survive make clean)"
echo "  src/core/builtin_modules.gen.inc (builtin.c include)"
echo "  build/mod/mod.load               (dlopen list, alongside .so)"
echo ""
echo "Run: make"
echo "After build:"
echo "  make install PREFIX=$PREFIX"
